numeric_columns = RF.select_dtypes(include=np.number).columns.tolist()

def IQR_method(RF, n, features):
    outlier_list = []

    for col in features:
        x = RF[col].to_numpy()
        Q1 = np.nanpercentile(x, 25)
        Q3 = np.nanpercentile(x, 75)
        IQR = Q3 - Q1
        step = 1.5 * IQR

        out_idx = RF[(RF[col] < Q1 - step) | (RF[col] > Q3 + step)].index
        outlier_list.extend(out_idx)

    counts = Counter(outlier_list)
    multiple_outliers = [k for k, v in counts.items() if v > 3] 

    print("Total rows flagged for deletion:", len(multiple_outliers))
    return multiple_outliers

